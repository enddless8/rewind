<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Rewind</AssemblyName>
    <RootNamespace>Replay</RootNamespace>
    <Product>Rewind</Product>
    <Title>Rewind</Title>
    <Description>Запись экрана и буфер Rewind</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.6</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/app/Rewind.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio.Wasapi" Version="2.3.0" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="FidelityChecks" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/app/Rewind.ico" Link="assets/app/Rewind.ico" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/tray/RewindTray.ico" Link="assets/tray/RewindTray.ico" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../../assets/fonts/Rewindtica-Bold.ttf" Link="assets/fonts/Rewindtica-Bold.ttf" />
    <Resource Include="../../assets/fonts/Rewindtica-Medium.ttf" Link="assets/fonts/Rewindtica-Medium.ttf" />
    <Resource Include="../../assets/fonts/Rewindtica-Light.ttf" Link="assets/fonts/Rewindtica-Light.ttf" />
    <Resource Include="../../assets/fonts/Inter_28pt-Regular.ttf" Link="assets/fonts/Inter_28pt-Regular.ttf" />
    <Content Include="../../assets/fonts/LICENSE-Rewindtica.txt" Link="licenses/fonts/LICENSE-Rewindtica.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/fonts/NOTICE-Rewindtica.txt" Link="licenses/fonts/NOTICE-Rewindtica.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/fonts/LICENSE-Inter.txt" Link="licenses/fonts/LICENSE-Inter.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY.md" Link="THIRD-PARTY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
