                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Сжимать MP4" Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" />
                                <Image x:Name="CompressionInfoIcon" Source="{StaticResource FigmaInfoIcon}" Style="{StaticResource SettingsInfoIcon}" Width="22.5" Height="22.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <Image.ToolTip><ToolTip Style="{StaticResource SettingsInfoToolTip}" Content="Уменьшает размер файла с минимальной потерей качества" /></Image.ToolTip>
                                </Image>
                            </WrapPanel>
                            <CheckBox x:Name="CompressCheck" Grid.Column="1" Style="{StaticResource SettingsToggle}" Click="CompressionChanged" VerticalAlignment="Center" AutomationProperties.Name="Сжимать MP4" ToolTip="Сжимать сохранённые клипы в MP4 в фоне" />
                        </Grid>
                        <StackPanel Visibility="{Binding ElementName=OutputNav, Path=IsChecked, Converter={StaticResource PageVisibility}}" Margin="0,18,0,0">
                            <Expander x:Name="OutputExtras" Header="Папки приложений и сжатие MP4" Style="{StaticResource SettingsExpander}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Название папки игры / приложения" Style="{StaticResource SettingsLabel}" />
                                    <Border Style="{StaticResource SettingsPathSurface}" IsEnabled="{Binding ElementName=CaptureFields, Path=IsEnabled}" Margin="0,8,0,0">
                                        <TextBox x:Name="GameNameBox" IsEnabled="{Binding ElementName=CaptureFields, Path=IsEnabled}" Style="{StaticResource SettingsPathText}" ToolTip="Пусто — имя exe. Сохраняется для этой игры." />
                                    </Border>
                                    <TextBlock Text="Используется при включённой группировке. Пустое название — имя приложения." Style="{StaticResource SettingsHelp}" Margin="0,6,0,16" />
                                    <TextBlock x:Name="CompressionProfileText" Foreground="{StaticResource RewindMuted}" FontSize="12" />
                                    <Button x:Name="ImportCompressionButton" Content="Настройки из MP4 Compressor…" Click="ImportCompression_Click" Style="{StaticResource AudioTestButton}" Margin="0,10,0,6" HorizontalAlignment="Left" />
                                    <TextBlock Text="Оригинал остаётся рядом. Один клип за раз; все звуковые дорожки сохраняются. Сжатие повышает нагрузку на GPU, но не останавливает буфер." Style="{StaticResource SettingsHelp}" />
                                    <TextBlock x:Name="CompressionStatusText" Foreground="{StaticResource RewindActive}" FontSize="12" Margin="0,8,0,0" Text="Очередь сжатия пуста" />
                                </StackPanel>
                            </Expander>
                            <Button x:Name="OpenOutputFolderButton" Content="Открыть папку клипов" Click="OpenFolder_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource RewindMuted}" Padding="0,8" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel x:Name="HotkeyHelp" Visibility="{Binding ElementName=HotkeysNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource SettingsHelp}" Margin="0,4,0,0" />
                            <TextBlock x:Name="HotkeyEditStatus" Style="{StaticResource SettingsHelp}" Foreground="{StaticResource RewindWarning}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="StatusText" />
                            <TextBlock x:Name="DetailText" />
                            <ProgressBar x:Name="MicMeter" Maximum="60" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,8,0,0" MaxWidth="680" MinHeight="0">
            <TextBlock x:Name="MainStateText" Style="{StaticResource RewindHelper}" MaxHeight="58" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <TextBlock x:Name="WarningText" Style="{StaticResource RewindHelper}" Foreground="{StaticResource RewindWarning}" MaxHeight="58" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <TextBlock x:Name="LastClipText" Style="{StaticResource RewindHelper}" MaxHeight="38" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=MainStateText, Path=Text}" Value="" />
                                <Condition Binding="{Binding ElementName=WarningText, Path=Text}" Value="" />
                                <Condition Binding="{Binding ElementName=LastClipText, Path=Text}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>
    </Grid>
</Window>
