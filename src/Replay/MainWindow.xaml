<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Replay" x:Class="Replay.MainWindow" Title="Rewind" Icon="pack://application:,,,/Rewind;component/assets/app/Rewind.ico" Width="820" Height="674" MinWidth="640" MinHeight="560" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{StaticResource RewindBackground}" Foreground="{StaticResource RewindForeground}" FontFamily="{StaticResource InterFont}" FontSize="14" PreviewMouseDown="MainWindow_PreviewMouseDown" PreviewKeyDown="MainWindow_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="MainView" Grid.RowSpan="2" Margin="-28">
            <!-- A single uniform scale preserves Figma proportions inside the fixed native
                 window; the layout uses Grid rows/columns, never canvas coordinates. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="MainLayout" Width="1018">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="90.5"/>
                        <RowDefinition Height="49.5"/>
                        <RowDefinition Height="367.5"/>
                        <RowDefinition Height="48.5"/>
                        <RowDefinition Height="64.5"/>
                        <RowDefinition Height="53.5"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Height="76" Margin="32.5,9,0,0" UseLayoutRounding="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="12"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsGear" Style="{StaticResource RewindIconButton}" Width="55" Height="55" Padding="0" VerticalAlignment="Center" Click="Settings_Click" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                            <Image Source="{StaticResource MainFigmaGearIcon}" Width="55" Height="55"/>
                        </Button>
                        <Button x:Name="MainFolderButton" Grid.Column="2" Style="{StaticResource RewindIconButton}" Width="76" Height="76" Padding="0" VerticalAlignment="Center" Click="OpenFolder_Click" ToolTip="Открыть папку клипов" AutomationProperties.Name="Открыть папку клипов">
                            <Image Source="{StaticResource MainFigmaFolderIcon}" Width="76" Height="76"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Width="349" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="12"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MainTitle" Text="Rewind" Style="{StaticResource RewindTitle}"/>
                        <Button x:Name="RewindStatusButton" Grid.Column="2" Style="{StaticResource RewindIconButton}" Width="45" Height="23.5" Padding="0" Margin="0,9,0,0" VerticalAlignment="Center" Click="RewindStatus_Click" ToolTip="Буфер Rewind выключен" AutomationProperties.Name="Выбрать состояние Rewind">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23.5"/><ColumnDefinition Width="5.5"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="BufferStateDot" Fill="{StaticResource MainRewindInactive}" Width="23.5" Height="23.5"/>
                                <Image Grid.Column="2" Source="{StaticResource MainFigmaChevronIcon}" Width="16" Height="9" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="3" HorizontalAlignment="Center" Width="885.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="252.0915"/><ColumnDefinition Width="52.4085"/>
                            <ColumnDefinition Width="252.0915"/><ColumnDefinition Width="42.45025"/>
                            <ColumnDefinition Width="272"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="252.0915"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button x:Name="SaveButton" Style="{StaticResource MainSaveCircle}" Click="Save_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Сохранить последние секунды Rewind" AutomationProperties.Name="Сохранить Rewind">
                                <Image Width="109.5" Height="102" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource MainFigmaSaveIcon}"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=SaveButton, Path=IsEnabled}" Value="False"><Setter Property="Source" Value="{StaticResource MainFigmaSaveDisabledIcon}"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                    <Image.RenderTransform><TranslateTransform X="-2.8" Y="7.5"/></Image.RenderTransform>
                                </Image>
                            </Button>
                            <TextBlock Grid.Row="1" Text="Сохранить&#10;Rewind">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RewindActionLabel}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=SaveButton, Path=IsEnabled}" Value="False"><Setter Property="Opacity" Value="0.57"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2" x:Name="DurationText" Text="180 сек">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RewindDurationLabel}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=SaveButton, Path=IsEnabled}" Value="False"><Setter Property="Foreground" Value="#40FFFFFF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Column="1" Grid.ColumnSpan="3">
                            <!-- The label can use the neighboring gaps without clipping or moving the circle. -->
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52.4085"/><ColumnDefinition Width="252.0915"/><ColumnDefinition Width="42.45025"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="252.0915"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource MainActionCircle}" Click="Recording_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Начать запись" AutomationProperties.Name="Начать запись">
                                <Image x:Name="RecordingIcon" Source="{StaticResource MainFigmaPlayIcon}" Width="71" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center"><Image.RenderTransform><TranslateTransform X="9" Y="0.5"/></Image.RenderTransform></Image>
                            </Button>
                            <TextBlock x:Name="RecordingLabel" Grid.Row="1" Grid.ColumnSpan="3" Margin="9.95825,8,0,0" Width="300" Text="Начать запись" TextWrapping="NoWrap" HorizontalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RewindActionLabel}"><Style.Triggers>
                                    <Trigger Property="Text" Value="Остановить запись"><Setter Property="FontSize" Value="26"/></Trigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="RecordingDurationText" Grid.Row="2" Grid.Column="1" Text="0 сек" Visibility="Hidden" Style="{StaticResource RewindDurationLabel}" AutomationProperties.Name="Длительность записи"/>
                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions><RowDefinition Height="252.0915"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button x:Name="ScreenshotButton" Style="{StaticResource MainActionCircle}" Click="Screenshot_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Сделать скриншот выбранного источника" AutomationProperties.Name="Сделать скриншот">
                                <Image Source="{StaticResource MainFigmaScreenshotIcon}" Width="116.5" Height="116.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <TextBlock Grid.Row="1" Text="Сделать скриншот" Style="{StaticResource RewindActionLabel}" TextWrapping="NoWrap" Width="330" Margin="-29,8,-29,0" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Button x:Name="MicrophoneQuickButton" Grid.Row="5" Style="{StaticResource RewindIconButton}" Width="64.5" Height="64.5" Padding="0" HorizontalAlignment="Center" Click="MicrophoneQuick_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Выключить микрофон" AutomationProperties.Name="Выключить микрофон">
                        <Image x:Name="MicrophoneQuickIcon" Source="{StaticResource MainFigmaMicrophoneIcon}" Width="64.5" Height="64.5"/>
                    </Button>
                    <!-- Overlay spans header and gap; visibility never affects measured rows. -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Width="349" HorizontalAlignment="Center" Panel.ZIndex="5">
                        <Border x:Name="RewindSelector" Width="53" Height="78.5" Margin="0,37,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Background="#333131" BorderBrush="#535353" BorderThickness="0.5" CornerRadius="13.5" KeyboardNavigation.TabNavigation="Cycle">
                            <Grid Margin="0,0,0,5.5"><Grid.RowDefinitions><RowDefinition Height="28.5"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                <Button x:Name="ExpandedRewindStatusButton" Style="{StaticResource RewindSelectorAction}" Click="RewindStatus_Click" AutomationProperties.Name="Закрыть выбор состояния Rewind">
                                    <Grid Width="35.5"><Grid.ColumnDefinitions><ColumnDefinition Width="12.5"/><ColumnDefinition Width="9"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ExpandedBufferStateDot" Width="12.5" Height="12.5" Fill="{StaticResource MainRewindInactive}"/>
                                        <Image Grid.Column="2" Source="{StaticResource MainFigmaChevronIcon}" Width="16" Height="9" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="180"/></Image.RenderTransform></Image>
                                    </Grid>
                                </Button>
                                <Button x:Name="RewindOnButton" Grid.Row="1" Content="ON" Style="{StaticResource RewindSelectorAction}" Click="RewindOn_Click" AutomationProperties.Name="Включить Rewind"/>
                                <Button x:Name="RewindOffButton" Grid.Row="2" Content="OFF" Style="{StaticResource RewindSelectorAction}" Click="RewindOff_Click" AutomationProperties.Name="Выключить Rewind"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="-28,-28,-28,-28">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="PageVisibility" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SettingsSidebar}" Padding="18,13.5,10,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel x:Name="LanguageItem" Orientation="Horizontal" Margin="8,0,0,12" ToolTip="Смена языка появится позже" AutomationProperties.Name="Язык: русский">
                            <Image Source="{StaticResource FigmaLanguageIcon}" Width="36.5" Height="36.5" Stretch="Uniform" Margin="-5.75,0,2.25,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Язык" FontSize="18.3869" Foreground="{StaticResource RewindMuted}" />
                                <TextBlock Text="Русский" FontSize="11.5" Foreground="{StaticResource RewindMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="← На главный экран" Click="Back_Click" Background="Transparent" Foreground="{StaticResource RewindMuted}" Padding="4,10" Margin="0" FontSize="12" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold" Foreground="White" Margin="6,0,0,7" FontFamily="{StaticResource RewindticaFont}" />
                        <RadioButton x:Name="CaptureNav" GroupName="SettingsNavigation" Checked="SettingsNavigation_Checked" IsChecked="True" Style="{StaticResource SettingsNavigation}" AutomationProperties.Name="Захват видео">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource FigmaCaptureIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Style="{StaticResource FigmaNavigationIcon}" Margin="0,0,5,0" />
                                <TextBlock Text="Захват видео" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AudioNav" GroupName="SettingsNavigation" Checked="SettingsNavigation_Checked" Style="{StaticResource SettingsNavigation}" AutomationProperties.Name="Аудио">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource FigmaMicrophoneIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Style="{StaticResource FigmaNavigationIcon}" Margin="0,0,5,0" />
                                <TextBlock Text="Аудио" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OutputNav" GroupName="SettingsNavigation" Checked="SettingsNavigation_Checked" Style="{StaticResource SettingsNavigation}" AutomationProperties.Name="Вывод">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource FigmaFolderIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Style="{StaticResource FigmaNavigationIcon}" Margin="0,0,5,0" />
                                <TextBlock Text="Вывод" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="HotkeysNav" GroupName="SettingsNavigation" Checked="SettingsNavigation_Checked" Style="{StaticResource SettingsNavigation}" AutomationProperties.Name="Горячие клавиши">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource FigmaHotkeysIcon}" Width="38" Height="38" Stretch="Uniform" Style="{StaticResource FigmaNavigationIcon}" Margin="-5.25,-5.25,-0.25,-5.25" />
                                <TextBlock Text="Горячие клавиши" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AdvancedNav" GroupName="SettingsNavigation" Checked="SettingsNavigation_Checked" Style="{StaticResource SettingsNavigation}" AutomationProperties.Name="Дополнительно">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource FigmaAdvancedIcon}" Width="32" Height="32" Stretch="Uniform" Style="{StaticResource FigmaNavigationIcon}" Margin="-2.25,-2.25,2.75,-2.25" />
                                <TextBlock Text="Дополнительно" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="15,24.5,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,26">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=CaptureNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                        <Image Source="{StaticResource FigmaCaptureIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Margin="0,0,15.5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Захват видео" VerticalAlignment="Center" Style="{StaticResource SettingsHeading}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=AudioNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                        <Image Source="{StaticResource FigmaMicrophoneIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Margin="0,0,15.5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Аудио" VerticalAlignment="Center" Style="{StaticResource SettingsHeading}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=OutputNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                        <Image Source="{StaticResource FigmaFolderIcon}" Width="27.5" Height="27.5" Stretch="Uniform" Margin="0,0,15.5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Вывод" VerticalAlignment="Center" Style="{StaticResource SettingsHeading}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=HotkeysNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                        <Image Source="{StaticResource FigmaHotkeysIcon}" Width="38" Height="38" Stretch="Uniform" Margin="-5.25,-5.25,10.25,-5.25" VerticalAlignment="Center" />
                        <TextBlock Text="Горячие клавиши" VerticalAlignment="Center" Style="{StaticResource SettingsHeading}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=AdvancedNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                        <Image Source="{StaticResource FigmaAdvancedIcon}" Width="32" Height="32" Stretch="Uniform" Margin="-2.25,-2.25,13.25,-2.25" VerticalAlignment="Center" />
                        <TextBlock Text="Дополнительно" VerticalAlignment="Center" Style="{StaticResource SettingsHeading}" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,12">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="43.5,0,0,0">
                        <Grid x:Name="SettingsPanel">
                            <Grid x:Name="CaptureFields" Visibility="{Binding ElementName=CaptureNav, Path=IsChecked, Converter={StaticResource PageVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4493*" />
                                    <ColumnDefinition Width="0.5507*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="84" />
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="53" />
                                    <RowDefinition Height="74" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Режим захвата" Style="{StaticResource SettingsLabel}" Margin="0,0,12,0" />
                                <ComboBox x:Name="CaptureMode" Grid.Column="1" Style="{StaticResource SettingsCombo}" VerticalAlignment="Top">
                                    <ComboBoxItem Content="Приложение" Tag="Game" />
                                    <ComboBoxItem Content="Приложение + рабочий стол" Tag="Desktop" />
                                </ComboBox>
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="Экран" Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" />
                                    <Image x:Name="MonitorInfoIcon" Source="{StaticResource FigmaInfoIcon}" Style="{StaticResource SettingsInfoIcon}" Width="22.5" Height="22.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Image.ToolTip><ToolTip Style="{StaticResource SettingsInfoToolTip}" Content="Для режима захвата рабочего стола" /></Image.ToolTip>
                                    </Image>
                                </WrapPanel>
                                <ComboBox x:Name="MonitorPicker" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCombo}" VerticalAlignment="Top" Opacity="1" ToolTip="Экран для захвата рабочего стола" />
                                <WrapPanel Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="Приложение" Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" />
                                    <Image x:Name="ApplicationInfoIcon" Source="{StaticResource FigmaInfoIcon}" Style="{StaticResource SettingsInfoIcon}" Width="22.5" Height="22.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Image.ToolTip><ToolTip Style="{StaticResource SettingsInfoToolTip}" Content="Для режима захвата приложения" /></Image.ToolTip>
                                    </Image>
                                </WrapPanel>
                                <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <local:ApplicationSourceComboBox x:Name="GamePicker" Style="{StaticResource SettingsCombo}" ItemTemplate="{StaticResource ApplicationSourceItem}" ItemContainerStyle="{StaticResource ApplicationSourceComboItem}" Opacity="1" ToolTip="Приложение для захвата" />
                                    <Button x:Name="RefreshSourceButton" Grid.Column="1" Click="Refresh_Click" ToolTip="Обновить список источников" AutomationProperties.Name="Обновить список источников" Style="{StaticResource RewindIconButton}" Width="28" Height="32" Padding="5" Margin="2,0,0,0">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="3" Text="Длительность Rewind" Style="{StaticResource SettingsLabel}" Margin="0,0,12,0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                    <local:DurationLandmarkPanel x:Name="DurationLandmarks">
                                        <local:DurationLandmarkPanel.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="FontSize" Value="11.5" />
                                                <Setter Property="Foreground" Value="{StaticResource RewindForeground}" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource RewindKeyboardFocus}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"><ContentPresenter /></Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="15" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="15" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="30" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="30" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="60" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="60" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="120" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="120" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="300" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="300" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=DurationBox, Path=Text}" Value="600" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="600" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource RewindActive}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </local:DurationLandmarkPanel.Resources>
                                        <Button Content="15 сек" Tag="15" Click="DurationLandmark_Click" />
                                        <Button Content="30 сек" Tag="30" Click="DurationLandmark_Click" />
                                        <Button Content="1 мин" Tag="60" Click="DurationLandmark_Click" />
                                        <Button Content="2 мин" Tag="120" Click="DurationLandmark_Click" />
                                        <Button Content="5 мин" Tag="300" Click="DurationLandmark_Click" />
                                        <Button Content="10 мин" Tag="600" Click="DurationLandmark_Click" />
                                    </local:DurationLandmarkPanel>
                                    <local:RewindDurationSlider x:Name="DurationSlider" Background="Transparent" TickPlacement="TopLeft" Ticks="0,1,2,3,4,5" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="5" SmallChange="0.01" LargeChange="0.1" PreviewKeyDown="DurationSlider_KeyDown" Value="{Binding ElementName=DurationBox, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DurationPositionConverter}}" AutomationProperties.Name="Длительность Rewind в секундах" ToolTip="От 15 до 600 секунд; клавиши ← и → меняют значение на 1 секунду" />
                                    <TextBlock x:Name="DurationValueText" Text="{Binding ElementName=DurationBox, Path=Text, Converter={StaticResource DurationTextConverter}}" FontSize="12" Foreground="{StaticResource RewindActive}" TextAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="Разрешение / FPS" Style="{StaticResource SettingsLabel}" Margin="0,0,12,0" />
                                <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="HeightPicker" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Разрешение">
                                        <ComboBoxItem Content="720p" Tag="720" />
                                        <ComboBoxItem Content="1080p" Tag="1080" />
                                        <ComboBoxItem Content="1440p" Tag="1440" />
                                        <ComboBoxItem Content="2160p" Tag="2160" />
                                    </ComboBox>
                                    <ComboBox x:Name="FpsPicker" Grid.Column="2" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="FPS">
                                        <ComboBoxItem Content="30 FPS" Tag="30" />
                                        <ComboBoxItem Content="60 FPS" Tag="60" />
                                    </ComboBox>
                                </Grid>
                                <WrapPanel Grid.Row="5" VerticalAlignment="Center" Orientation="Horizontal">
